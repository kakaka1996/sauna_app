<%= month_calendar events: @saunas do |date, saunas| %>
  <div class="space-y-1">
    <% saunas.each do |sauna| %>
      <%= link_to sauna_log_path(sauna),
          class: "flex items-center gap-1 p-1 bg-white/80 border border-cyan-200 rounded shadow-sm hover:bg-cyan-100 transition-colors" do %>
        <% if sauna.images.attached? %>
          <%= image_tag sauna.images.first.variant(resize_to_limit: [40, 40]), class: "w-4 h-4 object-cover rounded-sm shrink-0" %>
        <% end %>
        <span class="text-[10px] sm:text-xs text-cyan-800 truncate"><%= sauna.facility %></span>
      <% end %>
    <% end %>
  </div>
<% end %>


<div class="mt-8 mb-12 flex justify-center">
  <%= link_to "新規作成", new_sauna_log_path, class: "inline-flex items-center px-6 py-2 text-sm font-medium text-white bg-blue-400 rounded hover:bg-slate-700 transition-colors" %>
</div>